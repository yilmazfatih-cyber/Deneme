# docker compose için örnek ayarlar — kopyalayın: cp ornek.env .env
AIP_DATA_DIR=./data
AIP_LLM_ENGINE=auto
# gpu profili: vLLM konteyneri
AIP_LLM_BASE_URL=http://llm:8000/v1
AIP_VLLM_MODEL_PATH=/models/qwen3.5-35b-a3b/fp8
AIP_VLLM_SERVED_NAME=qwen3.5-35b-a3b
AIP_LLM_CONTEXT=32768
# cpu profili: llama-server
AIP_GGUF_PATH=/models/qwen3.5-4b/q4_k_m/Qwen3.5-4B-Q4_K_M.gguf
AIP_MMPROJ_PATH=/models/qwen3.5-4b/q4_k_m/mmproj-F16.gguf
AIP_LLM_THREADS=8
# ERP (salt-okunur kullanıcı!)
AIP_ERP_DB_URL=
AIP_ERP_ALLOWED_TABLES=[]
AIP_ERP_WEBHOOK_SECRET=
