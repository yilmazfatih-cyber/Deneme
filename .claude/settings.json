{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run validate:content)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run shots)",
      "Bash(SHOTS_DIR=* npm run shots)",
      "Bash(npm run symbols)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Bash(git push:*)", "Bash(rm -rf /:*)", "Read(./.env)", "Read(./.env.*)"]
  }
}
