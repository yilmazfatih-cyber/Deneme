{
  "modul": "fark",
  "aciklama": "fark modülünün iki dilde ortak sınama vektörleri (Myers; eşitlikte aynı seçimi yapar).",
  "islevler": {
    "diffSequences": [
      {
        "girdi": [
          ["a", "b", "c", "a", "b", "b", "a"],
          ["c", "b", "a", "b", "a", "c"]
        ],
        "cikti": [
          { "type": "delete", "items": ["a", "b"] },
          { "type": "equal", "items": ["c"] },
          { "type": "insert", "items": ["b"] },
          { "type": "equal", "items": ["a", "b"] },
          { "type": "delete", "items": ["b"] },
          { "type": "equal", "items": ["a"] },
          { "type": "insert", "items": ["c"] }
        ]
      },
      { "girdi": [[], []], "cikti": [] },
      {
        "girdi": [
          [1, 2],
          [1, 2]
        ],
        "cikti": [{ "type": "equal", "items": [1, 2] }]
      },
      {
        "girdi": [
          [1, true],
          [1, 1]
        ],
        "cikti": [
          { "type": "equal", "items": [1] },
          { "type": "delete", "items": [true] },
          { "type": "insert", "items": [1] }
        ]
      }
    ],
    "diffLines": [
      {
        "girdi": ["a\nb\nc", "a\nB\nc"],
        "cikti": [
          { "type": "equal", "items": ["a"] },
          { "type": "delete", "items": ["b"] },
          { "type": "insert", "items": ["B"] },
          { "type": "equal", "items": ["c"] }
        ]
      },
      { "girdi": ["a\r\nb\r\n", "a\nb"], "cikti": [{ "type": "equal", "items": ["a", "b"] }] }
    ],
    "unifiedDiff": [
      {
        "girdi": ["a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n", "a\nB\nc\nd\ne\nf\ng\nh\nI\nj\n"],
        "secenek": { "context": 1, "fromFile": "eski.txt", "toFile": "yeni.txt" },
        "cikti": "--- eski.txt\n+++ yeni.txt\n@@ -1,3 +1,3 @@\n a\n-b\n+B\n c\n@@ -8,3 +8,3 @@\n h\n-i\n+I\n j\n"
      },
      {
        "girdi": ["a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n", "a\nB\nc\nd\ne\nf\ng\nh\nI\nj\n"],
        "cikti": "--- a\n+++ b\n@@ -1,10 +1,10 @@\n a\n-b\n+B\n c\n d\n e\n f\n g\n h\n-i\n+I\n j\n"
      },
      { "girdi": ["", "x\ny\n"], "cikti": "--- a\n+++ b\n@@ -0,0 +1,2 @@\n+x\n+y\n" },
      { "girdi": ["x\ny\n", ""], "cikti": "--- a\n+++ b\n@@ -1,2 +0,0 @@\n-x\n-y\n" },
      { "girdi": ["a\nb\nc\n", "a\nc\n"], "cikti": "--- a\n+++ b\n@@ -1,3 +1,2 @@\n a\n-b\n c\n" },
      { "girdi": ["aynı\n", "aynı\n"], "cikti": "" }
    ],
    "diffObjects": [
      {
        "girdi": [
          { "a": 1, "b": { "c": 2, "d": [1, 2] }, "e": "x" },
          { "a": 1, "b": { "c": 3, "d": [1] }, "f": null }
        ],
        "cikti": [
          { "path": ["b", "c"], "kind": "changed", "before": 2, "after": 3 },
          { "path": ["b", "d", 1], "kind": "removed", "before": 2 },
          { "path": ["e"], "kind": "removed", "before": "x" },
          { "path": ["f"], "kind": "added", "after": null }
        ]
      },
      { "girdi": [{ "a": [1, { "b": true }] }, { "a": [1, { "b": true }] }], "cikti": [] },
      { "girdi": [1, "1"], "cikti": [{ "path": [], "kind": "changed", "before": 1, "after": "1" }] },
      { "girdi": [1, true], "cikti": [{ "path": [], "kind": "changed", "before": 1, "after": true }] }
    ]
  }
}
