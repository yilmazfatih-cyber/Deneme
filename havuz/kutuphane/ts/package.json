{
  "name": "havuz-kutuphane",
  "version": "0.1.0",
  "private": true,
  "description": "Tek dosyalık, bağımlılıksız, testli yardımcı modüller (TypeScript yarısı).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write . \"../*.{md,json}\" ../docs ../vektorler",
    "format:check": "prettier --check . \"../*.{md,json}\" ../docs ../vektorler",
    "test": "vitest run",
    "copy": "node kopyala.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
