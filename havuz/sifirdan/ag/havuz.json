    { "ara": "sifirdan-ag", "anlam": "paket (dağıtım) adı — pyproject.toml" },
    { "ara": "sifirdan-istemci/0.1", "anlam": "HTTP istemcisinin User-Agent değeri" },
    { "ara": "sifirdan-vekil", "anlam": "ters vekilin Via başlığındaki adı" },
    { "ara": "sifirdan.yerel", "anlam": "SMTP sunucusunun karşılama adı" }
