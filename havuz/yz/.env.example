# Ortam değişkenleri örneği. Gerçek değerleri .env dosyasına ya da kabuğunuza yazın (.env depoya girmez).
# yz.yaml olmadan tek bir OpenAI uyumlu sunucu tanımlamak için:
YZ_TABAN_URL=http://localhost:11434/v1
YZ_MODEL=qwen2.5:0.5b
# YZ_API_ANAHTARI=            # sunucu anahtar istiyorsa
# YZ_SAGLAYICI=ollama         # yz.yaml'daki profil adı
# YZ_AYAR=/yol/yz.yaml        # ayar dosyası başka yerdeyse
# YZ_VERI_DIZINI=.yz
# YZ_SUNUCU_ANAHTARI=         # python -m yz sun için API anahtarı
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# YZ_CANLI=1                  # canlı testleri aç (tests/test_canli.py)
# YZ_E2E=1                    # tarayıcı testlerini aç (tests/e2e)
