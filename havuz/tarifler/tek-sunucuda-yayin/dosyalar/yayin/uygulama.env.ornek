# /etc/uygulama/uygulama.env — uygulama.service ve uygulama-yedek.service bunu okur (systemd EnvironmentFile).
# Kopyalama: sudo install -D -m 0640 -o root -g uygulama yayin/uygulama.env.ornek /etc/uygulama/uygulama.env
# DEGISTIRIN yazan yerleri doldurun. Bu dosya sır içerir: depoya EKLEMEYİN, izni 0640 kalsın.
# Bütün değişkenlerin anlamı: uygulama/docs/YAYINLAMA.md §6.
NODE_ENV=production
HOST=127.0.0.1
PORT=8310
DATABASE_PATH=/var/lib/uygulama/uygulama.db
WEB_DIST=/srv/proje/uygulama/web/dist
APP_URL=https://app.ornek.com
TRUST_PROXY=1
ADMIN_EMAILS=DEGISTIRIN@ornek.com
LOG_LEVEL=info
# E-posta (şifre sıfırlama vb.). Sağlayıcı yoksa console: e-posta gitmez, yalnız mail_outbox tablosuna yazılır.
MAIL_PROVIDER=http
MAIL_FROM="Uygulama <bildirim@ornek.com>"
MAIL_HTTP_URL=https://DEGISTIRIN.example/emails
MAIL_HTTP_KEY=DEGISTIRIN
