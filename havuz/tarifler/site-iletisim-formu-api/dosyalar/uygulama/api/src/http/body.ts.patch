+/**
+ * Düz HTML form gövdesini (`application/x-www-form-urlencoded`) şemayla doğrular. YALNIZ oturum kullanmayan,
+ * herkese açık form uçları içindir (JS kapalı tarayıcı): burada CSRF duvarı JSON değil, köken denetimidir.
+ */
+export async function readForm<S extends z.ZodType>(c: Context<AppEnv>, schema: S): Promise<z.output<S>> {
+  const type = c.req.header('content-type') ?? ''
+  if (!/^application\/x-www-form-urlencoded\s*(;|$)/i.test(type))
+    throw new AppError('validation', MESSAGES.jsonRequired)
+  const body = await c.req.parseBody()
+  const fields = Object.fromEntries(Object.entries(body).filter(([, value]) => typeof value === 'string'))
+  return validate(schema, fields)
+}
