 import { cors } from 'hono/cors'
 import type { AppEnv } from './types.ts'
 
+/**
+ * Herkese açık form uçları (iletişim formu) için AYRI CORS: yalnız izinli kökenler, yalnız POST, çerezsiz.
+ * Genel CORS'tan (ALLOWED_ORIGINS, çerezli) bilerek ayrıdır: tanıtım sitesine uygulamanın oturumunu açmaz.
+ */
+export function publicFormCors(allowedOrigins: readonly string[]): MiddlewareHandler<AppEnv> {
+  const allowed = new Set(allowedOrigins)
+  return cors({
+    origin: (origin) => (allowed.has(origin) ? origin : null),
+    allowMethods: ['POST', 'OPTIONS'],
+    allowHeaders: ['Content-Type', 'Accept'],
+    exposeHeaders: ['Retry-After', 'X-Request-Id'],
+    credentials: false,
+    maxAge: 600,
+  })
+}
+
+/** Ara katmanı verilen adreslerde atlar (ör. genel CORS iletişim ucuna karışmasın). */
+export function exceptPaths(
+  paths: readonly string[],
+  middleware: MiddlewareHandler<AppEnv>,
+): MiddlewareHandler<AppEnv> {
+  const skip = new Set(paths)
+  return (c, next) => (skip.has(c.req.path) ? next() : middleware(c, next))
+}
