+def _stop(_signum: int, _frame: object) -> None:
+    raise KeyboardInterrupt  # SIGTERM (systemd, docker stop) Ctrl+C gibi düzgün kapatsın
+
+
+def _cmd_sun(args: argparse.Namespace) -> int:
+    key = os.environ.get(KEY_VARIABLE) or None
+    if args.adres not in LOCAL_HOSTS and key is None:
+        raise ValueError(t("sunucu_anahtar_gerekli", adres=args.adres, degisken=KEY_VARIABLE))
+    service = PredictionService.from_file(args.model, args.esik)
+    server = make_server(service, args.adres, args.kapi, key)
+    print(t("sunucu_hazir", adres=args.adres, kapi=server.server_address[1]), flush=True)
+    signal.signal(signal.SIGTERM, _stop)
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+    return 0
