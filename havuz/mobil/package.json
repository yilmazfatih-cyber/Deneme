{
  "name": "havuz-mobil",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "build:web": "expo export --platform web --output-dir dist --clear",
    "serve:web": "node scripts/serve-web.ts dist 5320",
    "e2e": "npm run build:web && playwright test --project=telefon-390 --project=telefon-360",
    "e2e:api": "node scripts/api-integration.ts",
    "shots": "npm run build:web && playwright test --project=ekran",
    "doctor": "expo install --check",
    "icons": "node scripts/icons.ts",
    "gen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen.ts",
    "shared:sync": "node scripts/shared-sync.ts",
    "test:gen": "node scripts/test-gen.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.65.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "description": "Yerel (native) mobil uygulama temeli: Expo + React Native, çevrimdışı-önce SQLite deposu ve havuz/uygulama API'siyle eşitleme",
  "engines": {
    "node": ">=22.18"
  }
}
