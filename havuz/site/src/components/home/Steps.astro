---
/**
 * "Nasıl çalışır?" bölümü: numaralı adımlar. Metinler: src/content/anasayfa/<dil>.json → steps
 */
import SectionHeader from './SectionHeader.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  anchor: string
  steps: CollectionEntry<'anasayfa'>['data']['steps']
}

const { anchor, steps } = Astro.props
---

<section id={anchor} aria-labelledby={`${anchor}-baslik`} class="border-y border-line bg-subtle py-20 md:py-28">
  <div class="wrap">
    <SectionHeader id={`${anchor}-baslik`} eyebrow={steps.eyebrow} title={steps.title} lead={steps.lead} />
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {steps.items.map((step, index) => (
        <li class="border-t border-line-strong pt-6">
          <span class="font-display text-5xl leading-none text-brand-ink" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
