---
/**
 * Özellikler bölümü: simgeli kart ızgarası. Metinler: src/content/anasayfa/<dil>.json → features (başlık),
 * src/content/ozellikler/<dil>.json → items (kartlar). Simge adları: src/components/icons.ts.
 */
import SectionHeader from './SectionHeader.astro'
import Icon from '../Icon.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  anchor: string
  header: CollectionEntry<'anasayfa'>['data']['features']
  items: CollectionEntry<'ozellikler'>['data']['items']
}

const { anchor, header, items } = Astro.props
---

<section id={anchor} aria-labelledby={`${anchor}-baslik`} class="py-20 md:py-28">
  <div class="wrap">
    <SectionHeader id={`${anchor}-baslik`} {...header} />
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="card p-6 transition-colors hover:border-line-strong md:p-7">
          <span class="inline-flex size-11 items-center justify-center rounded-xl border border-brand-line bg-brand-soft text-brand-ink">
            <Icon name={item.icon} size={22} />
          </span>
          <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
