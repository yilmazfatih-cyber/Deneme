---
/**
 * Başlık ve alt bilgideki marka: işaret + site adı. İşaretin şekli: src/lib/logo.ts.
 * Renkler temadan gelir (açık/koyu temada kendiliğinden uyar).
 */
import { logoMarkSvg } from '../lib/logo.ts'
import { siteConfig } from '../site.config.ts'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const mark = logoMarkSvg({ bg: 'var(--brand)', fg: 'var(--on-brand)', size: 30 })
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <span class="inline-flex" set:html={mark} />
  <span class="font-display text-[1.6rem] leading-none tracking-tight">{siteConfig.name}</span>
</span>
