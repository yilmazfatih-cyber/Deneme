---
/**
 * Şekil: en iyilenmiş görsel (AVIF/WebP, ekran boyutuna göre birden çok genişlik) + isteğe bağlı alt yazı.
 * MDX içinde:  import ekran from './ekran.png'   →   <Figure src={ekran} alt="…" caption="…" />
 * Markdown'da: ![alt metin](./ekran.png "Alt yazı")  (aynı sonucu verir; görsel de en iyilenir).
 * `alt` zorunludur; süs amaçlı görsellerde alt="" yazın.
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  caption?: string
  /** Görsel sayfanın ilk ekranında mı? (öncelikli yüklenir) */
  priority?: boolean
}

const { src, alt, caption, priority = false } = Astro.props
---

<figure class="figure">
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200].filter((width) => width <= src.width)}
    sizes="(min-width: 50rem) 46rem, 100vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
