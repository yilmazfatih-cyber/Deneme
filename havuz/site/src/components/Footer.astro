---
/**
 * Alt bilgi: marka ve kısa tanıtım, sosyal hesaplar, bağlantı sütunları, yasal bağlantılar, telif satırı.
 * İçerik src/site.config.ts → locales.<dil>.footer ve social alanlarından gelir; bu dosyayı düzenlemeniz gerekmez.
 */
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import type { BrandIconName, IconName } from './icons.ts'
import { useTranslations } from '../i18n/index.ts'
import { paths } from '../lib/routes.ts'
import { fill } from '../lib/text.ts'
import { link } from '../lib/url.ts'
import { siteConfig, type Locale } from '../site.config.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const footer = siteConfig.locales[locale].footer
const year = new Date().getFullYear()
const legalName = siteConfig.organization.legalName

const socialNames: Record<keyof typeof siteConfig.social, { label: string; icon: IconName }> = {
  github: { label: 'GitHub', icon: 'brand-github' satisfies BrandIconName },
  x: { label: 'X', icon: 'brand-x' satisfies BrandIconName },
  linkedin: { label: 'LinkedIn', icon: 'briefcase-business' },
  instagram: { label: 'Instagram', icon: 'brand-instagram' satisfies BrandIconName },
  youtube: { label: 'YouTube', icon: 'brand-youtube' satisfies BrandIconName },
  facebook: { label: 'Facebook', icon: 'brand-facebook' satisfies BrandIconName },
}
const social = (Object.entries(siteConfig.social) as [keyof typeof socialNames, string | undefined][])
  .filter((entry): entry is [keyof typeof socialNames, string] => entry[1] !== undefined)
  .map(([key, href]) => ({ href, ...socialNames[key] }))
---

<footer class="site-footer mt-24 border-t border-line bg-subtle">
  <div class="wrap grid gap-12 py-14 md:grid-cols-[1.3fr_2fr]">
    <div class="max-w-sm">
      <a
        href={link(paths.home(locale))}
        class="inline-flex rounded-xl"
        aria-label={fill(t.a11y.homeLink, { site: siteConfig.name })}
      >
        <Logo />
      </a>
      <p class="mt-4 text-[0.95rem] text-muted">{footer.tagline}</p>
      {social.length > 0 && (
        <ul class="mt-5 flex gap-1" aria-label={t.a11y.social}>
          {social.map((item) => (
            <li>
              <a href={item.href} class="icon-btn border-line" rel="me noopener">
                <Icon name={item.icon} size={18} />
                <span class="sr-only">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <nav aria-label={t.a11y.footerNav} class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {footer.columns.map((column) => (
        <div>
          <h2 class="text-sm font-semibold">{column.title}</h2>
          <ul class="mt-3 grid gap-1">
            {column.links.map((item) => (
              <li>
                <a
                  href={link(item.href)}
                  class="inline-flex min-h-9 items-center text-[0.95rem] text-muted hover:text-ink hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-3 py-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {legalName}
        {legalName.endsWith('.') ? ' ' : '. '}
        {t.footer.rights}
      </p>
      {footer.legal.length > 0 && (
        <nav aria-label={t.a11y.legalNav}>
          <ul class="flex flex-wrap gap-x-5 gap-y-1">
            {footer.legal.map((item) => (
              <li>
                <a href={link(item.href)} class="inline-flex min-h-9 items-center hover:text-ink hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </div>
</footer>
