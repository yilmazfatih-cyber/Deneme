---
/**
 * Simge: <Icon name="mail" /> — süs amaçlıdır (ekran okuyucudan gizli). Anlam taşıyorsa `label` verin.
 * Simge listesi ve lisanslar: src/components/icons.ts. Boyut: `size` (piksel) ya da `class="size-5"`.
 */
import { brandIcons, lineIcons, type BrandIconName, type IconName, type LineIconName } from './icons.ts'

interface Props {
  name: IconName
  size?: number
  class?: string
  /** Simge tek başına anlam taşıyorsa (yanında metin yoksa) ekran okuyucunun okuyacağı ad. */
  label?: string
}

const { name, size = 20, class: className, label } = Astro.props
const isBrand = name in brandIcons
const body = isBrand ? `<path d="${brandIcons[name as BrandIconName]}"/>` : lineIcons[name as LineIconName]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width={isBrand ? undefined : 1.75}
  stroke-linecap={isBrand ? undefined : 'round'}
  stroke-linejoin={isBrand ? undefined : 'round'}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
