---
/**
 * 404 sayfası. Statik barındırma servisleri (GitHub Pages, Netlify, Cloudflare Pages) bulunamayan her adres için
 * bu dosyayı (dist/404.html) gösterir. Varsayılan dilde yazılır; diğer diller için kısa bir bağlantı içerir.
 */
import Icon from '../components/Icon.astro'
import { useTranslations } from '../i18n/index.ts'
import BaseLayout from '../layouts/BaseLayout.astro'
import { paths } from '../lib/routes.ts'
import { link } from '../lib/url.ts'
import { defaultLocale, locales, siteConfig } from '../site.config.ts'

const t = useTranslations(defaultLocale)
const others = locales.filter((locale) => locale !== defaultLocale)
---

<BaseLayout locale={defaultLocale} title={t.notFound.title} description={t.notFound.description} noindex>
  <section class="wrap-narrow py-20 text-center md:py-28">
    <p class="font-display text-[clamp(5rem,3rem+10vw,9rem)] leading-none text-brand-ink" aria-hidden="true">
      404
    </p>
    <h1 class="display mt-4 text-[clamp(2.2rem,1.6rem+2.4vw,3.2rem)]">{t.notFound.title}</h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-muted">{t.notFound.description}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={link(paths.home(defaultLocale))} class="btn btn-primary">
        <Icon name="arrow-left" />
        {t.notFound.home}
      </a>
      <a href={link(paths.blog(defaultLocale))} class="btn btn-secondary">
        {t.notFound.blog}
      </a>
    </div>
    {others.map((locale) => {
      const other = useTranslations(locale)
      return (
        <p class="mt-10 text-sm text-muted" lang={siteConfig.locales[locale].lang}>
          {other.notFound.title}.{' '}
          <a href={link(paths.home(locale))} class="link">
            {other.notFound.home}
          </a>
        </p>
      )
    })}
  </section>
</BaseLayout>
