import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { docPaths } from '../../../lib/static-paths.ts'
import DocView from '../../../views/DocView.astro'

export const getStaticPaths = (() => docPaths('en')) satisfies GetStaticPaths
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { doc } = Astro.props as Props
---

<DocView doc={doc} />
