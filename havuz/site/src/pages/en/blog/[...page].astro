---
/** Blog list (English): /en/blog/, /en/blog/2/, … View: src/views/BlogListView.astro. */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { blogPagePaths } from '../../../lib/static-paths.ts'
import BlogListView from '../../../views/BlogListView.astro'

export const getStaticPaths = (({ paginate }) => blogPagePaths('en', paginate)) satisfies GetStaticPaths
type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props as Props
---

<BlogListView locale="en" page={page} />
