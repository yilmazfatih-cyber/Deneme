{
  "name": "havuz-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web sitesi temeli: tanıtım sayfası + blog + belgeler + iletişim (Astro, statik).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --port 4410",
    "build": "astro build",
    "preview": "astro preview --port 4411",
    "new": "node scripts/new.ts",
    "check": "npm run check:types && npm run lint && npm run format:check && npm run test && npm run check:site",
    "check:types": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:site": "node scripts/check-site.ts",
    "e2e": "node scripts/check-site.ts --build-only && playwright test",
    "shots": "node scripts/check-site.ts --build-only --root-only && playwright test --config playwright.shots.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "pagefind": "^1.6.0",
    "parse5": "^8.1.1",
    "satori": "^0.63.2",
    "satteri": "^0.11.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
