# Bu dosyayı ".env" adıyla kopyalayın ve gerekenleri doldurun. ".env" depoya girmez.
# Hepsi isteğe bağlıdır; boş bırakılırsa site.config.ts içindeki değerler kullanılır.

# Sitenin yayınlanacağı tam adres (sonda / olmadan). Örnek: https://www.ornek.com
SITE_URL=

# Site bir alt klasörde yayınlanacaksa o klasör. Örnek (GitHub Pages proje sitesi): /depo-adi/
SITE_BASE=

# İletişim formunun gönderileceği adres (Formspree, Web3Forms, Basin vb. bir form servisi).
# Boşsa form, ziyaretçinin e-posta uygulamasını açar (mailto:).
PUBLIC_FORM_ENDPOINT=

# Bülten kaydı formunun gönderileceği adres. Boşsa bülten kutusu hiç gösterilmez.
PUBLIC_NEWSLETTER_ENDPOINT=
