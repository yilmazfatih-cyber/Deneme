{
  "name": "tvplus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TV+ — Netflix web mimarisinin mekanikleriyle sıfırdan yazılmış akış uygulaması (öğretici, çalışan prototip)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n sunucu,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run persisted && vite build",
    "start": "tsx server/src/index.ts",
    "persisted": "tsx scripts/build-persisted.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:tagging": "tsx scripts/validate-tagging.ts",
    "tagging:guide": "tsx scripts/tagging-guide.ts",
    "mixpanel:import": "tsx scripts/mixpanel-import.ts",
    "sample:viewing": "tsx scripts/sample-viewing.ts",
    "analyze:shots": "tsx scripts/analyze-shots.ts",
    "embed:catalog": "tsx scripts/embed-catalog.ts",
    "ingest:youtube": "tsx scripts/ingest-youtube.ts",
    "package:title": "tsx scripts/package-title.ts",
    "check": "npm run persisted && npm run typecheck && npm run validate:content && npm run test",
    "e2e": "npm run build && playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.10",
    "@types/qrcode": "^1.5.6",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "graphql": "^16.11.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "undici": "^8.12.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
