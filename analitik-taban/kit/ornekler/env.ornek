# yerel/.env — GİZLİ. Git'e girmez; Claude'un bu dosyayı okuması izinlerle engellidir.
# Değerleri tırnaksız yazın; boş bırakılan satırlar yok sayılır. Ortam değişkeni varsa o önceliklidir.

# --- Mixpanel: service account (önerilen) ---
# Mixpanel → Organization Settings → Service Accounts → Add. Projeye en az "Consumer"/"Analyst" rolüyle ekleyin.
MIXPANEL_SA_USER=
MIXPANEL_SA_SECRET=
# Proje ID: Mixpanel → Project Settings → Overview (ayarlar.json'daki proje_id boşsa buradan okunur)
MIXPANEL_PROJECT_ID=

# --- Mixpanel: eski yöntem (service account yoksa) ---
# Project Settings → Access Keys → API Secret
MIXPANEL_API_SECRET=

# --- Hotjar API (yalnız API erişimi olan planlarda; yoksa boş bırakın, CSV ile çalışılır) ---
# Hotjar → Organization settings → API keys
HOTJAR_CLIENT_ID=
HOTJAR_CLIENT_SECRET=

# --- Şirket ağı (gerekirse) ---
# HTTPS_PROXY=http://proxy.sirket.local:8080
# SSL_CERT_FILE=/yol/kurumsal-kok-sertifika.pem
