# Kâhya ortam değişkenleri — kopyalayın: cp .env.example .env
# Boş bırakılan entegrasyonlar "kayıt modu"nda çalışır: mesajlar veritabanına yazılır, dışarı gönderilmez.

# --- Sunucu ---
PORT=8787
KAHYA_DB=./data/kahya.db
# Dış adres (PayTR dönüş adresleri ve güvenlik denetimi için zorunlu; HTTPS kullanın)
KAHYA_PUBLIC_URL=http://localhost:8787
# Demo modu: giriş kodu ekranda görünür, test ödeme sayfası açılır. CANLIDA 0 OLMALI.
KAHYA_DEMO=0
# Veritabanı boşsa örnek veri yükle (yalnız demo için)
KAHYA_SEED_DEMO=0
KAHYA_SESSION_DAYS=14

# --- Yapay zekâ (Claude) ---
# Anahtar yoksa yerel Türkçe kural motoru çalışır.
ANTHROPIC_API_KEY=
# Varsayılan claude-opus-5-5. Yüksek hacimde maliyet için claude-haiku-5-5 seçilebilir.
KAHYA_AI_MODEL=claude-opus-5-5
# kural | claude (boş: anahtar varsa claude)
KAHYA_AI=
# Kişisel verileri modele göndermeden önce maskele (KVKK). Kapatmayın.
KAHYA_AI_MASK_PII=1

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0
# 24 saat penceresi dışındaki iletiler için Meta'da onaylı şablon (tek gövde değişkeni {{1}})
WHATSAPP_TEMPLATE_NAME=kahya_bilgilendirme
WHATSAPP_TEMPLATE_LANG=tr

# --- SMS (Netgsm REST v2) ---
NETGSM_USERCODE=
NETGSM_PASSWORD=
# BTK onaylı gönderici adı (başlık)
NETGSM_HEADER=
NETGSM_APPNAME=kahya

# --- E-posta (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Site Yonetimi <bildirim@alanadiniz.com>

# --- Online ödeme (PayTR iFrame API) ---
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# --- Gelen SMS / e-posta webhook'ları için paylaşılan gizli anahtar (X-Kahya-Secret başlığı) ---
KAHYA_WEBHOOK_SECRET=
