{
  "name": "adet-takip",
  "private": true,
  "version": "0.1.0",
  "description": "Döngü — çevrimdışı çalışan Türkçe adet ve döngü takip uygulaması (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
