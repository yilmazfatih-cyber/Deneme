# Bu dosyayı ".env" adıyla kopyalayın ve doldurun:  cp env.example .env

# ---- Model sağlayıcı (tek anahtar, çok model) ----------------------------------------
# OpenAI uyumlu /v1 adresi. Varsayılan OpenRouter; Modelflare için https://modelflare.dev/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Sağlayıcıdan aldığınız TEK anahtar (zorunlu)
LLM_API_KEY=
# Adresten otomatik bulunur: openrouter | modelflare | generic (gerekirse elle yazın)
# LLM_PROVIDER=openrouter
# Sohbet başına /model ile değiştirilebilir; OpenRouter'da boş bırakılırsa openrouter/auto
DEFAULT_MODEL=openrouter/auto
# Kendi takma adlarınız (JSON): /model hizli → openai/gpt-5-mini gibi
# MODEL_ALIASES={"hizli":"openai/gpt-5-mini","akilli":"anthropic/claude-sonnet-4.5"}
APP_NAME=WA Asistan
# Ek HTTP başlıkları (JSON). Hermes'i beyin olarak kullanırken oturum başlığı için: {"X-Hermes-Session-Id":"wa"}
# LLM_EXTRA_HEADERS={}

# ---- Kim yazabilir ------------------------------------------------------------------
# Bağlanan hesap zaten sahiptir; "kendine mesaj" sohbetine yazdıklarınız yanıtlanır.
REPLY_IN_SELF_CHAT=true
# Bot, bu numaralardan gelen BİREBİR mesajlara da yanıt verir (ülke kodlu, + işaretsiz, virgülle)
# ALLOWED_NUMBERS=905321234567,905331234567
# Sahip numarasını elle sabitlemek isterseniz (normalde gerekmez)
# OWNER_NUMBER=905321234567
# Doluysa yalnızca bu önekle başlayan mesajlar yanıtlanır (kendine-mesaj sohbetini not defteri gibi
# kullanıyorsanız işe yarar). Komutlar (/model vb.) her zaman çalışır.
# TRIGGER_PREFIX=!

# ---- Bağlantı -----------------------------------------------------------------------
# Boşsa terminalde QR çıkar. Doluysa eşleştirme kodu üretilir (WhatsApp › Bağlı cihazlar › Telefon numarasıyla bağla)
# PAIRING_PHONE=905321234567

# ---- Sohbet ---------------------------------------------------------------------------
# SYSTEM_PROMPT=Sen kişisel bir asistansın. Kısa ve net yaz.
MAX_HISTORY=30
MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=180000
# Geçmiş diske yazılmasın isterseniz false (yeniden başlatınca sohbetler sıfırlanır)
HISTORY_PERSIST=true

# ---- Maliyet ve TL ------------------------------------------------------------------
# Elle kur (yazarsanız otomatik kur kaynakları kullanılmaz)
# USD_TRY=41.50
# Otomatik kur kaç saatte bir yenilensin (TCMB → frankfurter → er-api sırası)
FX_REFRESH_HOURS=6
# Kurun çarpanı: sağlayıcı komisyonu + banka kur farkı. 1 = hiçbiri. OpenRouter (%5,5) + banka (~%3) için ≈ 1.09
TL_CARPAN=1
# Aylık TL sınırı; 0 = sınırsız. Sınıra ulaşınca bot model çağırmaz, /butce ile artırılır
MONTHLY_BUDGET_TL=0
# Her yanıtın altına "≈ 0,12 TL · model" satırı
COST_FOOTER=true

# ---- Sesli mesaj (isteğe bağlı) -------------------------------------------------------
# OpenAI uyumlu /audio/transcriptions ucu. Boşsa sesli mesajlar yazıya dökülmez.
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# ---- Diğer ----------------------------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=info
