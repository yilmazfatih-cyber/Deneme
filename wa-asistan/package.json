{
  "name": "wa-asistan",
  "private": true,
  "version": "0.1.0",
  "description": "WhatsApp üzerinden çalışan, tek anahtarla 70+ modele erişen, maliyeti TL ile tutan kişisel asistan",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "dotenv": "^18.0.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
